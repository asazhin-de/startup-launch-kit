---
import Logo from "./Logo.astro";
import { site } from "../config";
import { navLinks } from "../site-helpers";
import { content } from "../site-content";
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <Logo />
      <p class="muted footer-tagline">{site.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <ul class="footer-links">
        {navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        {site.contactEmail && <li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>}
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom muted">
    <p>
      &copy; {new Date().getFullYear()} {site.name}
      {content.footerNote && <span class="footer-note"> · {content.footerNote}</span>}
    </p>
    <p>
      Built and hosted on <a href="https://workers.cloudflare.com">Cloudflare</a>
    </p>
  </div>
</footer>
