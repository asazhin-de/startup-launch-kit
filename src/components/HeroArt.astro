---
// Decorative illustration: a steaming pot on the edge network.
// Drawn in SVG and coloured with your brand colour automatically.
import { site } from "../config";
---

<div class="hero-art" aria-hidden="true">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <svg viewBox="0 0 480 380" class="hero-illustration" role="presentation">
    {/* edge network: dots and links around the pot */}
    <g class="net-lines">
      <path d="M60 90 L150 60 L250 40 L360 70 L430 130"></path>
      <path d="M40 220 L60 90"></path>
      <path d="M430 130 L450 250"></path>
    </g>
    <g class="net-dots">
      <circle cx="60" cy="90" r="6"></circle>
      <circle cx="150" cy="60" r="5"></circle>
      <circle cx="250" cy="40" r="6"></circle>
      <circle cx="360" cy="70" r="5"></circle>
      <circle cx="430" cy="130" r="6"></circle>
      <circle cx="40" cy="220" r="5"></circle>
      <circle cx="450" cy="250" r="5"></circle>
    </g>

    {/* steam */}
    <g class="art-steam">
      <path d="M190 150c-18-18 18-34 0-52"></path>
      <path d="M240 140c-18-18 18-34 0-52"></path>
      <path d="M290 150c-18-18 18-34 0-52"></path>
    </g>

    {/* pot */}
    <path class="art-handle" d="M96 222 H70 M384 222 h26"></path>
    <path class="art-pot" d="M100 206 H380 C380 300 320 346 240 346 C160 346 100 300 100 206 Z"></path>
    <path class="art-shine" d="M140 240 C148 280 172 306 206 318"></path>

    {/* plov on top: topping */}
    <path class="art-rice" d="M112 204 C150 160 330 160 368 204 Z"></path>
    <g class="art-topping">
      <rect x="170" y="182" width="34" height="7" rx="3.5" transform="rotate(-12 187 185)"></rect>
      <rect x="226" y="172" width="38" height="7" rx="3.5" transform="rotate(8 245 175)"></rect>
      <rect x="282" y="184" width="30" height="7" rx="3.5" transform="rotate(-6 297 187)"></rect>
      <rect x="200" y="194" width="26" height="6" rx="3" transform="rotate(14 213 197)"></rect>
      <rect x="250" y="192" width="28" height="6" rx="3" transform="rotate(-16 264 195)"></rect>
    </g>
    <rect class="art-rim" x="88" y="198" width="304" height="20" rx="10"></rect>

    {/* chips */}
    <g class="chip" transform="translate(8 284)">
      <rect width="132" height="40" rx="20"></rect>
      <text x="66" y="25" text-anchor="middle">330+ cities</text>
    </g>
    <g class="chip" transform="translate(342 300)">
      <rect width="132" height="40" rx="20"></rect>
      <text x="66" y="25" text-anchor="middle">0 cold starts</text>
    </g>
    <g class="chip chip-accent" transform="translate(300 18)">
      <rect width="170" height="40" rx="20"></rect>
      <text x="85" y="25" text-anchor="middle">{site.name}</text>
    </g>
  </svg>
</div>
