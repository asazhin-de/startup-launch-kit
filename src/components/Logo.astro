---
// The logo: a kazan (cauldron) with steam, in your brand colour.
import { site } from "../config";
---

<a class="logo" href="/" aria-label={`${site.name} home`}>
  <svg class="logo-mark" viewBox="0 0 32 32" width="34" height="34" aria-hidden="true">
    <g class="logo-steam" fill="none" stroke-width="1.8" stroke-linecap="round">
      <path d="M11 10c-1.6-1.6 1.6-3 0-4.6"></path>
      <path d="M16 10c-1.6-1.6 1.6-3 0-4.6"></path>
      <path d="M21 10c-1.6-1.6 1.6-3 0-4.6"></path>
    </g>
    <path class="logo-handle" d="M4.5 16.5H2.5M27.5 16.5h2" fill="none" stroke-width="2" stroke-linecap="round"></path>
    <path class="logo-pot" d="M5 15h22c0 7-4.4 12-11 12S5 22 5 15z"></path>
    <rect class="logo-rim" x="3" y="12.5" width="26" height="3.5" rx="1.75"></rect>
    <path class="logo-shine" d="M9 18.5c.6 2.6 2.4 4.6 5 5.4" fill="none" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
  <span class="logo-name">{site.name}</span>
</a>
