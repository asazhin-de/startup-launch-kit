---
// One page per blog post. Astro creates them at build time.
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../config";
import { formatDate } from "../../site-helpers";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true && (site.showPlovifyExamples || data.sample !== true));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | ${site.name}`} description={post.data.description}>
  <article class="section">
    <div class="container narrow-content">
      <a class="back-link" href="/blog/">← All posts</a>
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="muted">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.author && <> · {post.data.author}</>}
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>
